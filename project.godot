; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectRenai"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

run/main_scene="res://scenes/DebugStart.tscn"

[autoload]

GameManager="*res://scripts/GameManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
TimeManager="*res://scripts/TimeManager.gd"
ModLoader="*res://scripts/ModLoader.gd"
AudioManager="*res://scripts/AudioManager.gd"
LocalizationManager="*res://scripts/LocalizationManager.gd"
